# ─── Featherless.ai ───────────────────────────────────
FEATHERLESS_API_KEY=your_featherless_api_key_here
FEATHERLESS_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
FEATHERLESS_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
FEATHERLESS_TTS_MODEL=hexgrad/Kokoro-82M
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# ─── Supabase ─────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ─── Pinecone ─────────────────────────────────────────
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=bizpanion-schemes

# ─── Twilio (WhatsApp Sandbox) ────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── App ──────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
JWT_SECRET_KEY=your_jwt_secret_key_min_32_chars
AUDIO_CACHE_DIR=./audio_cache
MODEL_WEIGHTS_PATH=./models/forecast_model.pt
